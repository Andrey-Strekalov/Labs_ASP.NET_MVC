@model IEnumerable<ASP.NET_MVC_LABs.Models.Game>
@{
    ViewData["Title"] = ViewBag.Title ?? "Игры по году";
}

<h1>@ViewData["Title"]</h1>

<form method="get" class="row g-3 mb-4">
    <div class="col-auto">
        <label class="form-label">Год релиза</label>
        <input type="number" name="year" class="form-control" value="@ViewBag.Year" min="1970" max="2027" step="1">
    </div>
    <div class="col-auto align-self-end">
        <button type="submit" class="btn btn-primary">Применить</button>
        <a asp-action="Index" class="btn btn-secondary">Сбросить</a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-warning">Игры за указанный год не найдены</div>
}
else
{
    <p>Найдено игр: @Model.Count()</p>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Название</th>
                <th>Жанр</th>
                <th>Платформа</th>
                <th>Разработчик</th>
                <th>Рейтинг</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.Genre</td>
                    <td>@item.Platform</td>
                    <td>@item.Developer</td>
                    <td>@item.Rating / 10</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Детали</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
<a asp-action="Index" class="btn btn-secondary mt-2">← Назад</a>
