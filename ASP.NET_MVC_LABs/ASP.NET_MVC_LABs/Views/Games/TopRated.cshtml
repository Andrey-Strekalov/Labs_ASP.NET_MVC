@model IEnumerable<ASP.NET_MVC_LABs.Models.Game>
@{
    ViewData["Title"] = ViewBag.Title ?? "Топ игр по рейтингу";
}

<h1>@ViewData["Title"]</h1>

<form method="get" class="row g-3 mb-4">
    <div class="col-auto">
        <label class="form-label">Количество игр</label>
        <input type="number" name="count" class="form-control" value="@ViewBag.Count" min="1" max="20" step="1">
    </div>
    <div class="col-auto align-self-end">
        <button type="submit" class="btn btn-primary">Показать</button>
        <a asp-action="Index" class="btn btn-secondary">Назад</a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-warning">Нет игр в базе данных</div>
}
else
{
    <div class="alert alert-info">
        <strong>Топ @ViewBag.Count игр по рейтингу</strong>
    </div>
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>#</th>
                <th>Название</th>
                <th>Жанр</th>
                <th>Год</th>
                <th>Рейтинг</th>
                <th>Мультиплеер</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @{
                int rank = 1;
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@(rank++)</strong></td>
                    <td>@item.Title</td>
                    <td>@item.Genre</td>
                    <td>@item.ReleaseYear</td>
                    <td class="text-success fw-bold">@item.Rating / 10</td>
                    <td>@(item.IsMultiplayer ? "Да" : "Нет")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Детали</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
