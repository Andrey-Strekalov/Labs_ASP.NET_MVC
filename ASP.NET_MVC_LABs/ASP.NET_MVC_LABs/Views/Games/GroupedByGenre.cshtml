@model IEnumerable<ASP.NET_MVC_LABs.Models.Game>
@using System.Linq
@{
    ViewData["Title"] = "Игры по жанрам";
    var grouped = Model.GroupBy(g => g.Genre).OrderBy(g => g.Key);
}

<h1>Игры по жанрам</h1>

@if (!Model.Any())
{
    <div class="alert alert-warning">
        В базе данных нет игр. Добавьте хотя бы одну игру через <a asp-action="Create">форму создания</a>.
    </div>
}
else
{
    <div class="accordion" id="genresAccordion">
        @{
            int index = 0;
        }
        @foreach (var group in grouped)
        {
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button @(index != 0 ? "collapsed" : "")"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapse@(index)">
                        <strong>@group.Key</strong>
                        <span class="badge bg-secondary ms-2">@group.Count() игр</span>
                    </button>
                </h2>
                <div id="collapse@(index)"
                     class="accordion-collapse collapse @(index == 0 ? "show" : "")"
                     data-bs-parent="#genresAccordion">
                    <div class="accordion-body">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Название</th>
                                    <th>Год</th>
                                    <th>Рейтинг</th>
                                    <th>Платформа</th>
                                    <th>Мультиплеер</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var game in group)
                                {
                                    <tr>
                                        <td>@game.Title</td>
                                        <td>@game.ReleaseYear</td>
                                        <td class="text-success fw-bold">@game.Rating / 10</td>
                                        <td>@game.Platform</td>
                                        <td>
                                            @if (game.IsMultiplayer)
                                            {
                                                <span class="badge bg-success">Да</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Нет</span>
                                            }
                                        </td>
                                        <td>
                                            <a asp-action="Details" asp-route-id="@game.Id" class="btn btn-sm btn-info">Детали</a>
                                            <a asp-action="Edit" asp-route-id="@game.Id" class="btn btn-sm btn-warning">Изменить</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            index++;
        }
    </div>
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">← Назад к списку</a>
    <a asp-action="Create" class="btn btn-primary">Добавить новую игру</a>
</div>
